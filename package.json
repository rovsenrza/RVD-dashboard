{
  "name": "rvd-dashboard",
  "private": true,
  "version": "1.0.0-rc.3",
  "type": "module",
  "scripts": {
    "dev": "npm run dev -w @rvd/web",
    "build": "tsc -b && npm run build -w @rvd/web",
    "preview": "npm run preview -w @rvd/web",
    "lint": "oxlint apps/web/src apps/api packages",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "guide": "node scripts/build-guide.mjs",
    "msw:init": "npm run msw:init -w @rvd/web",
    "lint:arch": "bash scripts/check-arch.sh",
    "test:e2e": "playwright test -c playwright.live.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
