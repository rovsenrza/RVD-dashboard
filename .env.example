# Copy to .env.local — never commit real values.
VITE_API_BASE_URL=http://localhost:5173/api
VITE_USE_MOCKS=true

# 1С OData (read only) for apps/api; real values go to .env, never here
ODATA_URL=https://example.invalid/base/odata/standard.odata
ODATA_USER=
ODATA_PASSWORD=
# PORT=3001
# LOG_LEVEL=info
DATABASE_URL=postgres://rvd:rvd@127.0.0.1:5433/rvd

# The sync worker (Д26) in apps/api: a check for changes every 10 minutes, a full rebuild at 3 at night.
# Off for a second API instance; by hand: npm run sync -w @rvd/api (rebuild) or -- --check
# SYNC_ENABLED=true
# SYNC_INTERVAL_MS=600000
# SYNC_FULL_HOUR=3

# Letters (question 7): the customer's SMTP; unset — nothing is sent and nothing marked as sent.
# The day's notification digest goes out from NOTIFY_HOUR; messages to the specialist go to SUPPORT_EMAIL (question 15).
# SMTP_URL=smtps://user:password@mail.example.ru:465
# MAIL_FROM=РВД Кабинет <no-reply@example.ru>
# SUPPORT_EMAIL=
# NOTIFY_HOUR=7
# CABINET_URL=https://rvd.example.ru

# Files (Д25): where uploads live, ClamAV (unset — only the EICAR test file is caught), the path the browser reaches the API by
# FILES_DIR=data/files
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# PUBLIC_API_PATH=/api

# Requests to 1С (docs/1c/request-api.md): the order service and its own user; unset — requests wait in the queue.
# Locally the stand-in answers like 1С: npm run fake-1c -w @rvd/api
# ONEC_ORDERS_URL=http://127.0.0.1:3101/hs/rvd/v1/requests
# ONEC_ORDERS_USER=
# ONEC_ORDERS_PASSWORD=
# The full-cycle demo (docs/demo-full-cycle.md) reads order statuses from the stand-in too; unset in production
# ONEC_ORDER_STATES_URL=http://localhost:3101/odata

# Sign-in (Д6–Д7). The secret signs access tokens: 32+ random characters (openssl rand -base64 48).
# Without it apps/api will not start, unless AUTH_DISABLED=true: then sign-in is off and everyone is the demo user.
# JWT_SECRET=
# AUTH_DISABLED=true
# Wherever the cabinet is served over HTTPS: the refresh cookie travels only over HTTPS
# COOKIE_SECURE=true
# The 1С client (Клиент_Key) whose data is shown while sign-in is off; signed in, each company sees its own
# CABINET_CLIENT_KEY=
# Users: npm run user:add -w @rvd/api -- --company "ООО …" --client <Клиент_Key> --name "…" --email … --password … --role admin

# The customer's hosting (Beget, clientrvd.vgiz.ru), for scripts/deploy-beget.sh: SFTP into the site's folder
# BEGET_HOST=
# BEGET_USER=
# BEGET_PASS=
# BEGET_DIR=.
# BEGET_SITE=clientrvd.vgiz.ru

# Hybrid mode: what apps/api already serves (src/shared/api/live.ts) comes from 1С through it, the rest stays on mocks
# VITE_LIVE_API=true
# VITE_LIVE_API_URL=http://localhost:3001
